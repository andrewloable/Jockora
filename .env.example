#
# Copy to .env and edit. Compose reads .env automatically, so every later
# `docker compose logs`, `restart` and `down` works without re-exporting
# anything.
#
#     cp .env.example .env

# Your music. Mounted READ-ONLY; Jockora never writes to it.
MUSIC=/path/to/your/music

# Where the database and the Kokoro voice models live.
# MUST BE OWNED BY UID 10001:  sudo chown -R 10001 ./config
CONFIG=./config

# A directory containing a .gguf, and the filename inside it. A language model
# is an operator-supplied dependency; nothing is downloaded for you.
MODELS=./models
MODEL=qwen2.5-7b-instruct-q5_k_m.gguf
