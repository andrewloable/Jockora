# Agent and design documents — local working material, not part of the distributed work.
# Remove an entry here if you decide it should ship.
CLAUDE.md
.claude/
jockora_brainstorming_product_direction.md

.DS_Store

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# EVERY PATH BELOW IS ANCHORED WITH A LEADING SLASH, and that is not cosmetic.
# A bare "config/" matches a directory of that name at ANY depth, so it silently
# excluded internal/config -- core source -- and `git add` refused the whole
# path. Anchoring confines each pattern to the repository root, which is the
# only place any of them were ever meant to apply.

# Scraped third-party material must never enter a repository that is
# dual-licensed for commercial sale.
/transcripts/
/download_transcripts.sh

# Local runtime working material: a TTS virtualenv, the HLS segment directory,
# and the markdown a step-5.5 tuning round writes out for reading.
/.venv-tts/
/segments/
/breaks-round-*.md

# Kokoro model weights: hundreds of MB, operator-supplied, never vendored.
# Also the compose CONFIG directory, which holds the database and those weights.
/models/
/config/

# Local compose settings; .env.example is the template that ships.
/.env

# Demo audio. Not committed until the music licence is confirmed by the
# copyright holder; see Jockora-l6o.10.
docs/demo*.mp3
*.wav

# The browser app's dependencies and its build output. The app's SOURCE is
# tracked; what npm and ng produce from it is not.
/web/app/node_modules/
/web/dist/*
!/web/dist/.gitkeep
